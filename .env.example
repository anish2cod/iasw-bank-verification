# Copy this file and set your values via conda env config vars or shell export
# Never commit actual keys to git

# Required — get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# LLM provider: "gemini" (default) | "groq" | "ollama"
LLM_PROVIDER=gemini

# OCR provider: "gemini_vision" (default, handles handwriting) | "tesseract"
OCR_PROVIDER=gemini_vision

# Models (defaults shown)
GEMINI_MODEL=gemini-2.0-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Storage
DATABASE_URL=sqlite:///./iasw.db
UPLOAD_DIR=./data/uploads
LOG_DIR=./logs
